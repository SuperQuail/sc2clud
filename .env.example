# ============================================================
# SC2clud 环境变量模板
#
# 键名与 sc2clud-core::config 一一对应；**真实值不要写在这里**，
# 生产值放外层工作区的 secrets/env/production.env（该目录永不进 git）。
# 优先级：内置默认值 < sc2clud.toml < 环境变量
# ============================================================

# ---------- 必填 ----------
# 下载签名密钥：必须与 nginx secure_link_md5 表达式中的密钥逐字节一致。
# 生成：openssl rand -hex 32
SC2CLUD_DOWNLOAD_SECRET=change-me

# ---------- 监听与站点 ----------
# 只监听回环：TLS 与限流由 nginx 承担
SC2CLUD_BIND=127.0.0.1:8080
SC2CLUD_BASE_URL=https://example.com

# ---------- 路径 ----------
# 默认取 <exe 同级>/data；生产固定为 /srv/sc2clud/data
SC2CLUD_DATA_DIR=/srv/sc2clud/data
# SC2CLUD_CONFIG=/srv/sc2clud/sc2clud.toml

# ---------- 日志 ----------
# 语法同 tracing 的 EnvFilter，例如 info / debug / sc2clud=debug,tower_http=info
SC2CLUD_LOG=info

# ---------- 可选覆盖 ----------
# SC2CLUD_DOWNLOAD_PREFIX=/dl
# SC2CLUD_URL_TTL_SECS=300
# SC2CLUD_MAX_UPLOAD_BYTES=52428800
