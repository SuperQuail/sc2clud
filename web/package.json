    "gate:ui": "node scripts/check-ui-usage.ts",
    "preview:dev": "vite --config vite.preview.config.ts",
    "preview:build": "vite build --config vite.preview.config.ts",
    "preview:shot": "node scripts/shoot-previews.ts",
    "preview:serve": "node scripts/serve-preview.ts preview-dist 5202",
    "gate:controls": "node scripts/check-controls.ts",
    "devroom": "node scripts/serve-preview.ts preview-dist 5202",
    "gate:tokens": "node scripts/check-tokens.ts",
    "gate:urls": "node scripts/check-urls.ts",
    "gate:bundle": "node scripts/check-bundle.ts",
    "pack:dev": "node scripts/pack-dev.ts"
  },
