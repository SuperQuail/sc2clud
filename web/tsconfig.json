{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  // .tsx 必须在 include 里：否则 React 控件从来没被类型检查过（实测 19 个 .ts、0 个 .tsx），
  // 于是「用了没 import 的符号」这类错误会一路溜到浏览器（2026-10 评论消失回归的根因）。
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
