# 调试实例：与生产**完全隔离**。
#   - 独立端口 127.0.0.1:8081（不对外，需要时用 ssh -L 进去）
#   - 独立数据目录 /srv/sc2clud/data-debug（碰不到生产库）
#   - 打开调试页与「应用自己回图片字节」，方便本地/远程调试新功能
# 生产实例（sc2clud.service）不开这些开关。
[Unit]
Description=SC2clud 调试实例（仅回环，独立数据目录）
After=network.target

[Service]
Type=simple
# 必须用**自己的** env 文件：systemd 里 EnvironmentFile= 会覆盖 Environment=，
# 若复用生产的 sc2clud.env，调试实例会读到生产的 bind/data_dir 然后抢 8080（踩过一次）。
EnvironmentFile=/srv/sc2clud/sc2clud-debug.env
# 兜底写一份，即便 env 文件缺项也不会跑错目录/端口
Environment=SC2CLUD_BIND=127.0.0.1:8081
Environment=SC2CLUD_DATA_DIR=/srv/sc2clud/data-debug
Environment=SC2CLUD_BASE_URL=http://127.0.0.1:8081
Environment=SC2CLUD_DEBUG_PAGES=1
Environment=SC2CLUD_SERVE_BLOBS_LOCALLY=1
Environment=SC2CLUD_LOG=debug
# 这台机器没有 journal，所以把输出落到文件（调试实例的目录里），排障才看得见
StandardOutput=append:/srv/sc2clud/data-debug/debug.log
StandardError=append:/srv/sc2clud/data-debug/debug.log
WorkingDirectory=/srv/sc2clud
ExecStart=/srv/sc2clud/sc2clud serve
Restart=on-failure
# 注意：**不要**照抄生产 unit 的 ProtectSystem=strict / ProtectHome=yes——
# 这个调试实例在沙箱下会以 status=101 直接退出（踩过一次），
# 而它只监听回环、数据目录独立，隔离靠的是端口与数据目录，不是文件系统沙箱。
NoNewPrivileges=yes
MemoryHigh=96M
MemoryMax=160M
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
